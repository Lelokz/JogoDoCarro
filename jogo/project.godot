; Arquivo de configuração do Godot.

config_version=5

[application]

config/name="Protótipo - Futebol de Carro"
run/main_scene="res://cenas/campo_teste.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controles="*res://scripts/controles.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"
3d/default_gravity=6.5

[rendering]

anti_aliasing/quality/msaa_3d=2
